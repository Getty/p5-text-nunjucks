#!/usr/bin/env perl
use strict;
use warnings;
use Test::More;
use Scalar::Util qw( weaken );
use Path::Tiny ();

use Text::Nunjucks::Environment;
use Text::Nunjucks::Context;
use Text::Nunjucks::Template;
use Text::Nunjucks::Runtime::Frame;
use Text::Nunjucks::Loader::FileSystem;

# Port-only regression tests for reference-count leaks (k107, k108, k109).
#
# JavaScript has a tracing GC, so upstream cannot leak a closure cycle; Perl
# frees by reference count and a cycle lives for the whole process. There is
# no upstream test and no oracle value for "this object is gone": the oracle
# only says what a template must RENDER, and that part is pinned as corpus
# cases (t/corpus/render-macro-lifetime.json, generated by maint/corpus-regen).
#
# Method: every Context, Runtime::Frame and Template constructed is recorded
# as a weakened reference; after a render has returned, the objects of that
# render that are still defined were kept alive by a cycle. Object counts,
# not memory, so the result is deterministic.
#
# Every assertion that fails today because of a leak is a TODO naming its
# card; when a card is fixed the TODO block starts to pass ("TODO passed") and
# its TODO is removed. Controls and guards are plain tests and must stay green.

my %live;
{
  no strict 'refs';
  no warnings 'redefine';
  for my $pair (
    [ Context  => 'Text::Nunjucks::Context' ],
    [ Frame    => 'Text::Nunjucks::Runtime::Frame' ],
    [ Template => 'Text::Nunjucks::Template' ],
    )
  {
    my ( $kind, $class ) = @$pair;
    my $orig = $class->can('new');
    *{ $class . '::new' } = sub {
      my $obj = $orig->(@_);
      push @{ $live{$kind} }, $obj;
      weaken( $live{$kind}[-1] );
      return $obj;
    };
  }
}

sub alive { my ($kind) = @_; scalar grep { defined } @{ $live{$kind} || [] } }

# Run $code once as a warm-up (a caching loader compiles and keeps its
# templates; that is not a leak), forget what was created, run it three more
# times and report what is still alive, e.g. "Context=0 Frame=0 Template=0".
sub survivors {
  my ( $code, @kinds ) = @_;
  $code->();
  %live = ();
  $code->() for 1 .. 3;
  return join ' ', map { "$_=" . alive($_) } @kinds;
}

my $dir = Path::Tiny->tempdir;
my %files = (
  'part.njk'      => 'P',
  'base.njk'      => '<{% block c %}base{% endblock %}>',
  'lib.njk'       => '{% macro m() %}{{ x }}{% endmacro %}',
  'libplain.njk'  => '{% macro m() %}plain{% endmacro %}',
  'page.njk'      => 'A{% include "part.njk" %}B',
  'child.njk'     => '{% extends "base.njk" %}{% block c %}{{ super() }}!{% endblock %}',
  'nosuper.njk'   => '{% extends "base.njk" %}{% block c %}child{% endblock %}',
);
$dir->child($_)->spew_raw( $files{$_} ) for keys %files;

sub new_env {
  my (%o) = @_;
  return Text::Nunjucks::Environment->new( Text::Nunjucks::Loader::FileSystem->new( ["$dir"], \%o ) );
}

my @ALL = qw( Context Frame Template );

# [ name, template, card-or-undef, kinds ]
# The cases are measured with render_string on a long-lived Environment (the
# FileSystem loader caches what it loads), so Template counts only the
# render_string template of each render.
my @cases = (
  # ---- controls: nothing is kept today
  [ 'control: for / if / output',                  '{% for i in [1,2] %}{{ i }}{% endfor %}{% if x %}{{ x }}{% endif %}', undef ],
  [ 'control: asyncAll',                           '{% asyncAll i in [1,2,3] %}{{ i }}{% endall %}', undef ],
  [ 'control: macro with no outer-name read',      '{% macro m() %}plain{% endmacro %}{{ m() }}', undef ],
  [ 'control: plain macro in a block',             '{% block c %}{% macro m() %}plain{% endmacro %}{{ m() }}{% endblock %}', undef ],
  [ 'control: plain macro in a for loop',          '{% for i in [1] %}{% macro m() %}plain{% endmacro %}{{ m() }}{% endfor %}', undef ],
  [ 'control: plain macro in an if',               '{% if 1 %}{% macro m() %}plain{% endmacro %}{{ m() }}{% endif %}', undef ],
  [ 'control: from-import of a plain macro',       '{% from "libplain.njk" import m %}{{ m() }}', undef ],
  [ 'control: import as namespace, plain macro',   '{% import "libplain.njk" as l %}{{ l.m() }}', undef ],
  [ 'control: extends without super()',            '{% extends "base.njk" %}{% block c %}child{% endblock %}', undef ],
  [ 'control: extends with super() (objects)',     '{% extends "base.njk" %}{% block c %}{{ super() }}!{% endblock %}', undef ],
  [ 'control: a block alone',                      '{% block c %}x{% endblock %}', undef ],

  # ---- k107 (fixed): guards against waterfall / async_iter / async_for keeping
  # their own closure alive, and with it the Context and Frame of the render
  [ 'include',                                     'A{% include "part.njk" %}B', undef ],
  [ 'include in a for loop',                       '{% for i in [1,2,3] %}{% include "part.njk" %}{% endfor %}', undef ],
  [ 'include ignore missing, template missing',    'A{% include "nope.njk" ignore missing %}B', undef ],
  [ 'include of a missing template dies',          '{% include "nope.njk" %}', undef, 'dies' ],
  [ 'asyncEach',                                   '{% asyncEach i in [1,2,3] %}{{ i }}{% endeach %}', undef ],
  [ 'asyncEach over a dict',                       '{% asyncEach k, v in {a:1,b:2} %}{{ k }}{{ v }}{% endeach %}', undef ],
  [ 'asyncEach containing an include',             '{% asyncEach i in [1,2] %}{% include "part.njk" %}{% endeach %}', undef ],

  # ---- k108 cycle A: Context -> exported macro -> captured $context
  [ 'macro reading an outer name',                 '{% macro m() %}{{ x }}{% endmacro %}{{ m() }}', 'k108' ],
  [ 'macro reading an outer name, never called',   '{% macro m() %}{{ x }}{% endmacro %}', 'k108' ],
  [ 'macro reading a global',                      '{% macro m() %}{{ range(0,2) | join("") }}{% endmacro %}{{ m() }}', 'k108' ],
  [ 'macro calling a sibling macro',               '{% macro a() %}{{ b() }}{% endmacro %}{% macro b() %}B{% endmacro %}{{ a() }}', 'k108' ],
  [ 'macro calling itself',                        '{% macro m(n) %}{% if n %}{{ m(n - 1) }}{% endif %}{{ n }}{% endmacro %}{{ m(2) }}', 'k108' ],
  [ 'call block / caller()',                       '{% macro m() %}[{{ caller() }}]{% endmacro %}{% call m() %}c{% endcall %}', 'k108' ],
  [ 'from-import of a macro reading an outer name','{% from "lib.njk" import m %}{{ m() }}', 'k108' ],
  [ 'import as namespace, macro reading an outer name', '{% import "lib.njk" as l %}{{ l.m() }}', 'k108' ],
  [ 'macro defined in a block, reading an outer name', '{% block c %}{% macro m() %}{{ x }}{% endmacro %}{{ m() }}{% endblock %}', 'k108' ],
  [ 'macro that dies while called with a caller block (outer read)',
    '{% macro m() %}{{ x }}{{ caller() }}{{ nope() }}{% endmacro %}{% call m() %}c{% endcall %}', 'k108', 'dies' ],

  # ---- k108 cycle B: a macro stored in a frame that its captured $frame reaches
  [ 'macro stored with set, no outer read',        '{% macro m() %}plain{% endmacro %}{% set f = m %}{{ f() }}', 'k108' ],
  [ 'macro defined and set in a block, no outer read', '{% block c %}{% macro m() %}plain{% endmacro %}{% set f = m %}{{ f() }}{% endblock %}', 'k108' ],
  [ 'control: macro set inside a for loop, no outer read',  '{% for i in [1] %}{% macro m() %}plain{% endmacro %}{% set f = m %}{{ f() }}{% endfor %}', undef ],
  [ 'from-import with context inside a for loop, plain macro',
    '{% for i in [1] %}{% from "libplain.njk" import m with context %}{{ m() }}{% endfor %}', 'k108' ],
  [ 'macro that dies while called with a caller block (no outer read)',
    '{% macro m() %}{{ caller() }}{{ nope() }}{% endmacro %}{% call m() %}c{% endcall %}', 'k108', 'dies' ],
);
my %todo_text = (
  k108 => 'k108: macros capture $context and $frame, so Context and Frame of the render are kept',
);

my $ctx = { x => 'X', rows => [ 1 .. 5 ] };

subtest 'render_string on a long-lived Environment keeps nothing of a finished render' => sub {
  my $env = new_env();
  for my $case (@cases) {
    my ( $name, $src, $card, $mode ) = @$case;
    my $run = sub {
      my $out = eval { $env->render_string( $src, $ctx ) };
      if ( ( $mode // '' ) eq 'dies' ) {
        die "expected a render error for '$name'\n" if !$@;
      }
      else {
        die $@ if $@;
      }
    };
    my $got = survivors( $run, @ALL );
    TODO: {
      local $TODO = $card ? $todo_text{$card} : undef;
      is( $got, 'Context=0 Frame=0 Template=0', $name );
    }
  }
};

# ---- k107: the scenario the Environment POD recommends: one Environment, a
# caching FileSystem loader, render by NAME. The cached Templates stay (that is
# the cache); the Context and Frame of each render must not.
subtest 'one Environment, cached FileSystem loader, render by name' => sub {
  my $env = new_env();
  my $got = survivors( sub { $env->render( 'page.njk', $ctx ) }, qw( Context Frame ) );
  is( $got, 'Context=0 Frame=0', 'render of a template with an include' );

  $got = survivors( sub { $env->render( 'nosuper.njk', $ctx ) }, qw( Context Frame ) );
  is( $got, 'Context=0 Frame=0', 'control: render of an extending template' );

  $got = survivors( sub { eval { $env->render('nope.njk') }; die 'no error' if !$@ }, qw( Context Frame ) );
  is( $got, 'Context=0 Frame=0', 'control: render of a template no loader has (cache miss, error)' );

  my $noc = new_env( noCache => 1 );
  $got = survivors( sub { $noc->render( 'page.njk', $ctx ) }, @ALL );
  is( $got, 'Context=0 Frame=0 Template=0', 'noCache loader: render of a template with an include' );
};

# ---- k107: a cache miss on get_template itself (async_iter in get_template)
subtest 'get_template cache miss' => sub {
  my $env = new_env();
  my $got = survivors(
    sub {
      my ( $e, $t ) = ( 'unset', 'unset' );
      $env->get_template( 'nope.njk', sub { ( $e, $t ) = @_ } );
      die 'expected an error' if !$e;
    },
    @ALL
  );
  is( $got, 'Context=0 Frame=0 Template=0', 'control: get_template of a missing name, callback form' );

  $got = survivors(
    sub {
      my @r;
      $env->get_template( 'nope.njk', 0, undef, 1, sub { @r = @_ } );
    },
    @ALL
  );
  is( $got, 'Context=0 Frame=0 Template=0', 'get_template of a missing name with ignore_missing' );

  $got = survivors( sub { $env->get_template( 'part.njk', sub { } ) }, @ALL );
  is( $got, 'Context=0 Frame=0 Template=0', 'control: get_template of a name that is cached' );
};

# ---- k109 (fixed): the compiled block coderef. The Template itself was always
# freed; the compiled block sub used to be kept alive by passing the variable
# holding it to get_super. These tests guard that: the block coderef (the
# entry in the Template's blocks) is what is weakened here.
subtest 'compiled block code is freed with its Template' => sub {
  my $env = new_env();
  for my $case (
    [ 'a block that calls super()',   '{% extends "base.njk" %}{% block c %}{{ super() }}!{% endblock %}', '<base!>', undef ],
    [ 'a block that calls super() in a for loop',
      '{% extends "base.njk" %}{% block c %}{% for i in [1,2] %}{{ super() }}{% endfor %}{% endblock %}', '<basebase>', undef ],
    [ 'control: a block without super()', '{% extends "base.njk" %}{% block c %}child{% endblock %}', '<child>', undef ],
    [ 'control: a root block',        '{% block c %}x{% endblock %}', 'x', undef ],
    )
  {
    my ( $name, $src, $expect, $card ) = @$case;
    my ( $weak, $out );
    {
      my $tmpl = Text::Nunjucks::Template->new( $src, $env, 'k109.njk' );
      $tmpl->compile;
      $weak = $tmpl->blocks->{c};
      weaken($weak);
      $out = $tmpl->render($ctx);
    }
    is( $out, $expect, "$name: renders" );
    TODO: {
      local $TODO = $card ? $todo_text{$card} : undef;
      ok( !defined $weak, "$name: block coderef freed once the Template is gone" );
    }
  }
};

# ---------------------------------------------------------------------------
# Guards: behaviour that works today only because nothing is ever freed. The
# k108 fix makes macros capture their Context weakly and has the importer keep
# a library's Context alive; these must stay green. The template-level guards
# (from-import with a sibling call and a global, import as namespace,
# re-export, import inside a macro, with-context import) are corpus cases in
# t/corpus/render-macro-lifetime.json (expected from the oracle). What a
# template cannot express is the Perl API: get_exported (Template POD).
# ---------------------------------------------------------------------------
subtest 'guard: macros returned by Template->get_exported work after it returned' => sub {
  my $env = new_env();

  # same library as the corpus guard "from-import of one macro ..."; the
  # oracle renders a() as [V012bh] there.
  my $lib = Text::Nunjucks::Template->new(
    q({% set v = 'V' %}{% macro a() %}[{{ v }}{{ range(0,3) | join('') }}{{ b() }}{{ _helper() }}]{% endmacro %})
      . q({% macro b() %}b{% endmacro %}{% macro _helper() %}h{% endmacro %}),
    $env, 'lib-direct.njk'
  );

  my ( $err, $exported );
  $lib->get_exported( {}, sub { ( $err, $exported ) = @_ } );
  is( $err, undef, 'get_exported: no error' );
  is( ref $exported, 'HASH', 'get_exported: hands over a hash' );
  ok( exists $exported->{$_}, "exported has '$_'" ) for qw( a b );
  ok( !exists $exported->{_helper}, 'a name with a leading underscore is not exported' );

  is( ( $exported->{b}->() ) . '', 'b', 'a plain macro works after get_exported returned' );
  is( ( $exported->{a}->() ) . '', '[V012bh]', 'a macro that calls a sibling and reads a global and a library variable' );
  is( ( $exported->{a}->() ) . '', '[V012bh]', '... and a second time' );

  undef $lib;
  is( ( $exported->{a}->() ) . '', '[V012bh]', '... also after the Template object is gone' );
};

done_testing;
